// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id String @id @default(uuid())
  clerkId String @unique
  name String?
  email String?
  products Product[]
}

model Product {
  id String @id @default(uuid())
  name String
  description String?
  userId String
  imageUrl String?
  user User @relation(fields: [userId], references: [id])
  type Product_type
}

enum Product_type {
  CONSTRUCTION_MATERIALS
  INDUSTRIAL_PIPES
  SPECIALIZED_EQUIPMENT
}

model Client {
  id           Int     @id @default(autoincrement())
  code_client  Int     @unique
  client       String
  adress       String?
  province     String
  nif          Int?
  stat         Int?
  rcs          String?
  cf           String?
  contact      String?
  phone        String?
  mail         String?
}

model Article {
   id             Int     @id @default(autoincrement())
  reference      String  @unique
  designation    String?
  categorie      String?
  uom            String?
  prix_achat_ttc Float?
  prix_vente_ttc Float?
}

// Facture proforma. Les données client et article sont COPIÉES au moment de la
// création (pas de FK) : le document reste figé même si la fiche source évolue.
// Le PDF rendu est stocké dans Vercel Blob (`pdf_url`) ; le proforma est
// immuable après sauvegarde.
model Proforma {
  id                Int            @id @default(autoincrement())
  pf_num            String         @unique
  date              DateTime
  // Copie figée des données client.
  client_code       String
  client_name       String
  client_address    String?
  client_province   String
  client_nif        String?
  client_stat       String?
  client_rcs        String?
  client_contact    String?
  client_phone      String?
  client_mail       String?
  // Conditions commerciales.
  votre_reference   String?
  validite_offre    DateTime?
  terme_paiement    Int
  monnaie           String
  tva_active        Boolean        @default(false)
  tva_rate          Float          @default(20)
  // Totaux recalculés côté serveur à la création.
  sous_total        Float
  remise            Float
  montant_net       Float
  montant_tva       Float
  montant_total     Float
  montant_en_lettres String
  pdf_url           String
  created_at        DateTime       @default(now())
  items             ProformaItem[]
}

model ProformaItem {
  id           Int      @id @default(autoincrement())
  proforma_id  Int
  proforma     Proforma @relation(fields: [proforma_id], references: [id], onDelete: Cascade)
  // Copie figée des données article + spécifications techniques.
  designation  String
  max_loading  String?
  pressure     String?
  dimension    String?
  uom          String?
  quantite     Float
  prix_unitaire Float
  remise_pct   Float    @default(0)
  montant_net  Float
}